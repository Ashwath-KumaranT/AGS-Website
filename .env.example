# Data source: "mock" (default, localStorage-backed, no backend needed) or "supabase"
VITE_DATA_SOURCE=mock

# Supabase (only needed when VITE_DATA_SOURCE=supabase). The anon key is public by design;
# access is enforced by row-level security. NEVER put the service-role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public site URL used for canonical links / Open Graph tags
VITE_SITE_URL=http://localhost:5173

# Display currency (ISO 4217) and locale
VITE_CURRENCY=INR
VITE_LOCALE=en-IN

# Server-side secrets live ONLY in Supabase Edge Function secrets (see supabase/README.md):
#   PAYMENT_WEBHOOK_SECRET, PAYMENT_PROVIDER_SECRET_KEY, SUPABASE_SERVICE_ROLE_KEY
